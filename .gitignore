# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Incremental build cache written by `tsc -b` (npm run typecheck)
*.tsbuildinfo
# Service worker generated by vite-plugin-pwa during `npm run dev`
dev-dist
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Workflow-only artifacts (generated by scripts in CI, not committed)
stale-report.md
topic-suggestions.md

# Exported legacy Supabase rows — contains contact emails, never commit
legacy-supabase-export

# Local environment. The anon key is public-by-design, but this file is
# where a real secret would eventually land — keep it out of git.
.env

# Plugin-installed agent skills. `.claude/skills/` holds two different kinds
# of thing: a few skills written for this project and committed deliberately,
# and symlinks into `.agents/skills/` created by installing a plugin. Ignore
# everything by default so a new plugin install doesn't show up as untracked
# noise, then re-admit the project's own skills by name.
.agents/
.claude/skills/*
!.claude/skills/design-taste-frontend/
!.claude/skills/frontend-design/
!.claude/skills/ui-ux-pro-max/

# Scratch area. Holds a build zip and recovered git lock files; nothing here
# should ever reach a commit.
_to_delete/
